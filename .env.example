# All settings are optional. Loaded automatically by `pnpm start` / `pnpm mcp` / the LaunchAgent.

# --- Scanner daemon ----------------------------------------------------------
# SCAN_INTERVAL_SEC=60
# TOLERANCE_SCANS=2

# --- MCP server: remote networks ---------------------------------------------
# By default only the "local" network (this machine's LAN) is available.
# Remotes are reached over SSH (key-based, BatchMode) and must have this project
# checked out at "path" (default /opt/network-tracker) with node on the remote PATH.
# NETWORK_TRACKER_REMOTES_JSON={"office":{"ssh":"user@office-host","path":"/opt/network-tracker","aliases":["work"]},"cabin":"cabin-host"}
# Network used when a tool call doesn't specify one
# DEFAULT_NETWORK=local

# --- WhatsApp alerts (daemon) -------------------------------------------------
# Disabled unless WHATSAPP_TARGET_CHAT is set. Expects an HTTP bridge exposing
# POST {WHATSAPP_API_URL}/api/send-message with JSON {account?, to, text}.
# WHATSAPP_API_URL=http://127.0.0.1:3333
# WHATSAPP_TARGET_CHAT=
# WHATSAPP_ACCOUNT=
# Comma-separated person names that trigger a once-per-day arrival alert
# NETWORK_TRACKER_ARRIVAL_ALERTS=Alice,Bob
# IANA timezone for alert timestamps (defaults to the system timezone)
# NETWORK_TRACKER_TIMEZONE=Europe/Madrid
